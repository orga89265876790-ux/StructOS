# Create a dedicated Supabase project for StructOS and use only its public browser values.
# Never add a secret key or service_role key to this file or GitHub Pages.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# GitHub Pages currently serves the source directly. For that mode, copy the same
# public values into auth-config.js. A publishable key is safe for browser use;
# secret and service_role keys are never allowed there.
